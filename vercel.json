{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {"root": ".", "runtime": "container", "entrypoint": "Dockerfile.vercel"}
  },
  "rewrites": [
    {"source": "/(.*)", "destination": {"service": "web"}}
  ],
  "daemons": {
    "training": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "command": ["python", "-m", "gtex_explorer.platform.cloud.daemon"],
      "instances": {"sin1": 1},
      "resources": {"requests": {"memory": "2Gi"}},
      "terminationGracePeriodSeconds": 60
    }
  }
}
