# Restore training data in its own stage so the packed chunks never reach the final image.
FROM python:3.12-slim-bookworm AS training-data
WORKDIR /app
COPY gtex_explorer/__init__.py gtex_explorer/paths.py gtex_explorer/
COPY scripts/ scripts/
COPY resources/ resources/
RUN python -m scripts.bundled_training_data restore

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt \
    && pip install --no-cache-dir --no-deps xgboost==3.2.0
COPY app.py cloud_app.py desktop.py ./
COPY gtex_explorer/ gtex_explorer/
COPY scripts/ scripts/
COPY cloud-config.toml .streamlit/config.toml
COPY data/ data/
COPY assets/ assets/
COPY model_bundle/ model_bundle/
COPY baseline_bundle/ baseline_bundle/
COPY --from=training-data /app/training_data/ training_data/
# Run times are shown in Western Indonesia Time; a POSIX TZ string needs no tzdata.
ENV TZ=WIB-7 GTEX_CLOUD=1 GTEX_DESKTOP_STATE_DIR=/tmp/gtex-cloud-state \
    PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PORT=80
CMD ["sh", "-c", "exec python -m streamlit run cloud_app.py --server.address 0.0.0.0 --server.port ${PORT:-80} --server.headless true --server.fileWatcherType none --browser.gatherUsageStats false"]
